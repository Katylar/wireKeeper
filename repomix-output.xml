<file path="frontend/src/styles/layout/activity.scss">
.activity-page {
    padding: 2rem;
    color: #cdd6f4; // Mocha text

    .page-header {
        margin-bottom: 2rem;
        h1 {
            margin: 0;
            color: #89b4fa;
        }
        p {
            color: #a6adc8;
            margin-top: 0.5rem;
        }
    }
}

.activity-section {
    background: #181825;
    border: 1px solid #313244;
    border-radius: 8px;
    padding: 1.5rem;
    margin-bottom: 2rem;

    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
        border-bottom: 1px solid #313244;
        padding-bottom: 1rem;

        h2 {
            margin: 0;
            font-size: 1.25rem;
        }

        .batch-controls {
            display: flex;
            align-items: center;
            gap: 1.5rem;
        }

        .batch-stats {
            color: #a6adc8;
            font-style: italic;
        }

        .btn-kill-danger {
            background: rgba(243, 139, 168, 0.1);
            color: #f38ba8;
            border: 1px solid #f38ba8;
            padding: 0.5rem 1rem;
            border-radius: 4px;
            cursor: pointer;
            font-weight: bold;
            transition: all 0.2s;
            &:hover {
                background: #f38ba8;
                color: #11111b;
            }
        }
    }
}

/* Chat Unit Styles */
.chat-unit {
    border: 1px solid #313244;
    border-radius: 6px;
    margin-bottom: 1rem;
    background: #1e1e2e;
    overflow: hidden;

    &.pending {
        opacity: 0.7;
        .unit-header {
            background: #181825;
        }
    }

    .unit-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.75rem 1rem;

        &.active-bg {
            background: rgba(137, 180, 250, 0.1);
            border-bottom: 1px solid #313244;
        }

        .title-group {
            display: flex;
            align-items: center;
            gap: 1rem;

            .title {
                font-weight: bold;
                font-size: 1.1rem;
            }

            .tags {
                display: flex;
                gap: 0.5rem;
                .tag {
                    font-size: 0.75rem;
                    padding: 0.1rem 0.4rem;
                    border-radius: 4px;
                    &.warn {
                        background: rgba(249, 226, 175, 0.2);
                        color: #f9e2af;
                    }
                    &.info {
                        background: rgba(137, 180, 250, 0.2);
                        color: #89b4fa;
                    }
                }
            }
        }

        .btn-skip {
            background: transparent;
            border: 1px solid #f38ba8;
            color: #f38ba8;
            border-radius: 4px;
            padding: 0.3rem 0.8rem;
            cursor: pointer;
            &:hover {
                background: rgba(243, 139, 168, 0.2);
            }
        }
    }

    .unit-body {
        padding: 1rem;

        .scan-status {
            color: #f9e2af;
            font-size: 0.9rem;
            margin-bottom: 1.5rem;
        }
    }
}

/* Worker Queues inside Chat Unit */
.worker-queue {
    margin-bottom: 1.5rem;

    .queue-title {
        font-size: 0.8rem;
        font-weight: bold;
        color: #a6adc8;
        margin-bottom: 0.5rem;
        letter-spacing: 1px;
    }

    .worker-row {
        display: grid;
        grid-template-columns: 3fr 4fr 1fr;
        align-items: center;
        gap: 1rem;
        padding: 0.4rem 0;
        font-size: 0.9rem;

        .worker-info {
            display: flex;
            flex-direction: column;
            .filename {
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }
            .queue-pos {
                font-size: 0.75rem;
                color: #6c7086;
            }
        }

        .progress-container {
            height: 6px;
            background: #313244;
            border-radius: 3px;
            overflow: hidden;

            .progress-bar {
                height: 100%;
                background: #89b4fa; // Blue for heavy
                transition: width 0.2s;
                &.light-bg {
                    background: #a6e3a1;
                } // Green for light
            }
        }

        .speed {
            text-align: right;
            color: #a6adc8;
            font-variant-numeric: tabular-nums;
        }
    }
}

/* Finished Files */
.finished-section {
    margin-top: 1rem;
    border-top: 1px dashed #313244;
    padding-top: 1rem;

    .toggle-btn {
        background: none;
        border: none;
        color: #89b4fa;
        cursor: pointer;
        font-size: 0.9rem;
        padding: 0;
        &:hover {
            text-decoration: underline;
        }
    }

    .finished-list {
        margin-top: 0.5rem;
        max-height: 200px;
        overflow-y: auto;
        background: #11111b;
        padding: 0.5rem;
        border-radius: 4px;

        .finished-row {
            font-size: 0.85rem;
            padding: 0.2rem 0;
            display: flex;
            gap: 0.5rem;
            align-items: center;

            &.success {
                color: #a6e3a1;
            }
            &.error {
                color: #f38ba8;
            }

            .filename {
                color: #cdd6f4;
            }
            .error-text {
                color: #f38ba8;
                font-style: italic;
                font-size: 0.75rem;
            }
        }
    }
}

/* History Terminal */
.history-terminal {
    background: #11111b;
    border: 1px solid #313244;
    border-radius: 6px;
    padding: 1rem;
    font-family: monospace;
    max-height: 400px;
    overflow-y: auto;
    font-size: 0.9rem;

    .history-line {
        margin-bottom: 0.4rem;
        display: flex;
        gap: 1rem;

        .timestamp {
            color: #6c7086;
        }
        .action {
            color: #cdd6f4;
            font-weight: bold;
        }
        .stats {
            color: #a6adc8;
            .success {
                color: #a6e3a1;
                font-weight: bold;
            }
            .failed {
                color: #f38ba8;
                font-weight: bold;
            }
        }
    }
}

/* Detailed History Cards */
.history-card {
    background: #181825;
    border: 1px solid #313244;
    border-left: 4px solid #313244;
    border-radius: 6px;
    padding: 1rem;
    margin-bottom: 1rem;
    font-family: monospace;

    &.completed {
        border-left-color: #a6e3a1;
    }
    &.killed {
        border-left-color: #f9e2af;
    }
    &.error {
        border-left-color: #f38ba8;
    }

    .history-card-header {
        display: flex;
        justify-content: space-between;
        margin-bottom: 0.75rem;

        .chat-title {
            font-weight: bold;
            color: #cdd6f4;
            display: flex;
            align-items: center;
            gap: 0.5rem;

            .status-indicator {
                width: 8px;
                height: 8px;
                border-radius: 50%;
                &.completed {
                    background: #a6e3a1;
                }
                &.killed {
                    background: #f9e2af;
                }
                &.error {
                    background: #f38ba8;
                }
            }
        }
        .time-info {
            color: #6c7086;
            font-size: 0.85rem;
        }
    }

    .history-card-body {
        .stat-row {
            display: flex;
            gap: 1.5rem;
            font-size: 0.9rem;
            color: #a6adc8;
            margin-bottom: 1rem;
            strong {
                color: #cdd6f4;
            }
        }

        .category-breakdown {
            display: flex;
            gap: 0.75rem;
            flex-wrap: wrap;

            .cat-pill {
                background: #11111b;
                border: 1px solid #313244;
                border-radius: 4px;
                padding: 0.25rem 0.5rem;
                font-size: 0.8rem;
                display: flex;
                gap: 0.5rem;

                .cat-name {
                    color: #89b4fa;
                    font-weight: bold;
                }
                .success {
                    color: #a6e3a1;
                }
                .failed {
                    color: #f38ba8;
                }
                .aborted {
                    color: #f9e2af;
                }
                .skipped {
                    color: #6c7086;
                }
            }
        }
    }
}
</file>

<file path="frontend/src/styles/layout/filelist.scss">
// src/styles/layout/_filelist.scss

.file-list-container {
    display: flex;
    flex-direction: column;
    background: #1e1e2e;
    border-radius: 8px;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.3);
    overflow: hidden;
    height: 700px;
    margin-top: 1rem;

    // Top Bar: Filters (Left) & Counter (Right)
    .file-filters-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem 1.5rem;
        background: #181825;
        border-bottom: 1px solid #313244;

        .filters {
            display: flex;
            gap: 1.5rem;

            label {
                display: flex;
                align-items: center;
                gap: 0.5rem;
                color: #cdd6f4;
                font-size: 0.9rem;
                cursor: pointer;
                user-select: none;

                input[type="checkbox"] {
                    cursor: pointer;
                    width: 16px;
                    height: 16px;
                    accent-color: #89b4fa;
                }

                &.disabled {
                    color: #6c7086;
                    cursor: not-allowed;
                    input {
                        cursor: not-allowed;
                        opacity: 0.5;
                    }
                }
            }
        }

        .file-count {
            color: #a6e3a1; // Green accent for the counter
            font-weight: bold;
            font-size: 0.9rem;
            letter-spacing: 0.05em;
        }
    }

    // The 7-Column CSS Grid
    $grid-layout: 80px 2.5fr 100px 2fr 100px 140px 3fr;

    .file-table-header {
        display: grid;
        grid-template-columns: $grid-layout;
        background: #181825;
        padding: 0.75rem 1rem;
        font-size: 0.8rem;
        font-weight: 600;
        color: #a6adc8;
        text-transform: uppercase;
        border-bottom: 2px solid #313244;

        .sortable {
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 0.25rem;
            user-select: none;
            transition: color 0.2s;

            &:hover {
                color: #cdd6f4;
            }
            &.active {
                color: #89b4fa;
            }
        }
    }

    .file-row {
        display: grid;
        grid-template-columns: $grid-layout;
        align-items: center;
        padding: 0 1rem;
        border-bottom: 1px solid #313244;
        font-size: 0.85rem;
        color: #cdd6f4;
        transition: background-color 0.15s;

        &:hover {
            background: #313244;
        }

        .cell {
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            padding-right: 1rem;

            &.filename {
                font-family: "Consolas", "Courier New", monospace;
                color: #cdd6f4;
            }

            &.category {
                text-transform: capitalize;
                color: #f9e2af;
            }

            &.meta {
                color: #a6adc8;
            }

            &.null-text {
                color: #6c7086;
                font-style: italic;
            }

            &.clickable-path {
                color: #89b4fa;
                cursor: pointer;
                text-decoration: underline;
                text-decoration-color: transparent;
                transition: text-decoration-color 0.2s;

                &:hover {
                    text-decoration-color: #89b4fa;
                }
            }
        }
    }

    .empty-state {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100%;
        color: #6c7086;
        font-style: italic;
    }
}
